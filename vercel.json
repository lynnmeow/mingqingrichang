{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    { "source": "/(.*)\\.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, immutable" } ] },
    { "source": "/(.*)\\.css", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, immutable" } ] }
  ]
}
